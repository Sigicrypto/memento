# ── Supabase ────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Service role key — needed for server-side plan upgrades after payment
# Get from: Supabase Dashboard → Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── Admin ────────────────────────────────────────────────────────
# Server-only access code for admin elevation (NOT exposed to client)
ADMIN_ACCESS_CODE=your-secure-admin-code-here

# Super admin email — bypasses all feature/plan checks
SUPER_ADMIN_EMAIL=your-admin-email@example.com
# Client-side super admin for UI (mirrors the above for client components)
NEXT_PUBLIC_SUPER_ADMIN_EMAIL=your-admin-email@example.com

# ── Site URL ─────────────────────────────────────────────────────
# Required for auth redirects and CSRF validation in production
NEXT_PUBLIC_SITE_URL=https://your-production-domain.com

# ── Razorpay (India payments) ────────────────────────────────────
# Get from: https://dashboard.razorpay.com → Settings → API Keys
# Used when user's region cookie = 'IN'
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ── Stripe (Global payments) ─────────────────────────────────────
# Get from: https://dashboard.stripe.com → Developers → API Keys
# Used when user's region cookie = 'GLOBAL'
STRIPE_SECRET_KEY=your_stripe_secret_key

# ── Email (Resend) ───────────────────────────────────────────────
RESEND_API_KEY=your_resend_api_key

# ── Analytics (PostHog) ──────────────────────────────────────────
# NEXT_PUBLIC_POSTHOG_KEY=your_posthog_key
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
