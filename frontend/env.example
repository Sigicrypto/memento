# ── Supabase ────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Service role key — needed for server-side plan upgrades after payment
# Get from: Supabase Dashboard → Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── Admin ────────────────────────────────────────────────────────
NEXT_PUBLIC_ADMIN_ACCESS_CODE=memento-admin-2024
ADMIN_ACCESS_CODE=memento-admin-2024

# Optional: IP Whitelisting (comma-separated)
# ALLOWED_ADMIN_IPS=192.168.1.100,203.0.113.1

# Optional: Admin JWT Secret
# ADMIN_SECRET_KEY=your-super-secret-jwt-key-here

# ── Razorpay (India payments) ────────────────────────────────────
# Get from: https://dashboard.razorpay.com → Settings → API Keys
# Used when user's region cookie = 'IN'
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ── Stripe (Global payments) ─────────────────────────────────────
# Get from: https://dashboard.stripe.com → Developers → API Keys
# Used when user's region cookie = 'GLOBAL'
STRIPE_SECRET_KEY=your_stripe_secret_key
